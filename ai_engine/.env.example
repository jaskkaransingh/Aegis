# AEGIS AI Engine Environment Configuration (Example)
# Copy this file to .env inside ai_engine/ for local overrides

# Ollama Host and Port (Default: http://127.0.0.1:11434)
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Configured Model Name (Verified installed models: llama3.2:3b, qwen3:0.6b)
OLLAMA_MODEL=llama3.2:3b

# Request Timeout in Seconds
OLLAMA_TIMEOUT_SECONDS=60.0

# Maximum Generation Retries
OLLAMA_MAX_RETRIES=2

# Generation Temperature (Low temperature recommended for deterministic reasoning)
OLLAMA_TEMPERATURE=0.1

