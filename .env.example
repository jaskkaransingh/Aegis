# AEGIS Environment Configuration Example
# Copy this file to .env and adjust variables as needed

# Environment mode: development, staging, production
AEGIS_ENV=development

# Server Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=True

# Allowed CORS Origins (JSON list or comma-separated)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Cloud LLM Provider (for subsequent agent orchestration)
# Options: anthropic, openai, gemini
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
# API Keys (Placeholders - never commit real keys)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Investigation Data Paths (Relative to backend/app)
DATA_LOGS_PATH=data/logs.json
DATA_CLOCK_METADATA_PATH=data/clock_metadata.json
DATA_SERVICES_PATH=data/services.json

